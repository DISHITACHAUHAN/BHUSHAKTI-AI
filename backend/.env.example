# Application Settings
APP_NAME="BHUSHAKTI AI API"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL / PostGIS or SQLite fallback)
# For local SQLite fallback: sqlite:///./bhushakti.db
# For PostgreSQL with PostGIS: postgresql+psycopg2://postgres:postgres@localhost:5432/bhushakti_db
DATABASE_URL="sqlite:///./bhushakti.db"

# Gemini Generative AI (Optional / Decision Support)
GEMINI_API_KEY=""

# Data Simulation Settings
WEATHER_UPDATE_INTERVAL_SECONDS=10
SIMULATION_MODE=True
